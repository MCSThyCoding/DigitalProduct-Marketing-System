<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="page-heading">
  <div>
    <p class="eyebrow">Creator workspace</p>
    <h1>My products</h1>
    <p class="muted">Upload digital files, track sales, and manage your catalog.</p>
  </div>
  <div class="heading-actions">
    <a class="button secondary" href="/creator/coupons">Coupons</a>
    <a class="button primary" href="/creator/products/new">+ New product</a>
  </div>
</section>

<div class="flash info" style="margin-bottom: 18px;">
  Pending products are hidden from Browse until an admin approves them in Admin Panel.
</div>

<section class="stats-grid">
  <div class="stat-card"><span>Sales</span><strong><%= stats.sales_count %></strong></div>
  <div class="stat-card"><span>Earnings</span><strong><%= formatMoney(stats.earnings_cents) %></strong></div>
  <div class="stat-card"><span>Products</span><strong><%= productCount %></strong></div>
  <div class="stat-card"><span>Pending review</span><strong><%= pendingCount %></strong></div>
</section>

<% if (products.length === 0) { %>
  <div class="empty-state">
    <h2>No products yet</h2>
    <p>Upload your first digital product to start selling.</p>
    <a class="button primary" href="/creator/products/new">Upload product</a>
  </div>
<% } else { %>
  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Category</th>
          <th>Price</th>
          <th>Status</th>
          <th>Sales</th>
          <th>Earnings</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% products.forEach(function(product) { %>
          <tr>
            <td>
              <strong><%= product.title %></strong>
              <div class="muted"><%= product.original_filename %></div>
            </td>
            <td><%= product.category %></td>
            <td><%= formatMoney(product.price_cents) %></td>
            <td><span class="badge <%= product.status === 'live' ? '' : 'warning' %>"><%= product.status %></span></td>
            <td><%= product.sales_count %></td>
            <td><%= formatMoney(product.earnings_cents) %></td>
            <td class="actions">
              <a class="button secondary small" href="/creator/products/<%= product.id %>/edit">Edit</a>
              <form method="POST" action="/creator/products/<%= product.id %>/delete" onsubmit="return confirm('Remove this product from the marketplace?');">
                <button class="button danger small" type="submit">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include('../partials/footer') %>
