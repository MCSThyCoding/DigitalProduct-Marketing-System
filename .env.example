PORT=3000
SESSION_SECRET=change-this-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:3000

# Payment provider mode: auto, stripe, aba, demo
PAYMENT_PROVIDER=auto
# Set to false to hide the simulated Card payment option when Stripe/ABA are configured
PAYMENT_DEMO_ENABLED=true
# Set to true to show Cash / manual payment even when PAYMENT_PROVIDER is not auto
PAYMENT_MANUAL_ENABLED=true

# Stripe Checkout
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ABA PayWay / PayWay Checkout
ABA_ENV=sandbox
ABA_MERCHANT_ID=your_merchant_id
ABA_API_KEY=your_aba_api_key
ABA_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYMENT_OPTION=
ABA_LIFETIME_MINUTES=1440
ABA_VIEW_TYPE=hosted_view

JIRA_BASE_URL=https://chansethymen.atlassian.net
JIRA_EMAIL=your-atlassian-email.com
JIRA_API_TOKEN=your_api_token
JIRA_PROJECT_KEY=DIG

# Email OTP for registration (optional - without SMTP the code is shown in dev mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Digital Market <no-reply@example.com>"
# Set to true only for local testing without SMTP - shows the OTP on screen
OTP_DEV_ECHO=false